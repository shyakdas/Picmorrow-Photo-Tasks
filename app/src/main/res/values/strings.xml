    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_effective_date">Effective 30 September 2026</string>
    <string name="privacy_intro">Picmorrow is a local-first photo task app. This policy explains what the app accesses, how information is handled, and the controls available to you.</string>
    <string name="privacy_local_title">Information handled on your device</string>
    <string name="privacy_local_body">Picmorrow stores captured photos, task titles, notes, categories, reminder times, completion status, and app preferences in private app storage on your device. Picmorrow does not require an account.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Camera: used only when you open the camera to capture a photo task.\n\nNotifications: used to display task reminders when notifications are enabled. You can deny or change this permission in Android settings.\n\nHome-screen shortcut: created only when you request it and opens Picmorrow directly to the camera.</string>
    <string name="privacy_collection_title">Collection and sharing</string>
    <string name="privacy_collection_body">Picmorrow does not transmit your photos, task content, identifiers, usage activity, or diagnostics to the developer or to third parties. The app contains no advertising, analytics, or tracking SDKs and does not sell personal information.</string>
    <string name="privacy_export_title">Gallery exports</string>
    <string name="privacy_export_body">When you choose Save to gallery, Picmorrow copies that photo to the Pictures/Picmorrow folder through Android MediaStore. That copy is outside Picmorrow\'s private storage and remains in your gallery until you delete it there.</string>
    <string name="privacy_retention_title">Retention and deletion</string>
    <string name="privacy_retention_body">Tasks and app-held photos remain on your device until you delete them in Picmorrow or uninstall the app. Deleting a completed task removes its app-held record and photo but does not delete a copy previously saved to your gallery. Picmorrow keeps no remote account or server copy to delete.</string>
    <string name="privacy_security_title">Security</string>
    <string name="privacy_security_body">App-held information uses Android\'s private app storage and is not included in Picmorrow cloud backups. Device access protections, operating-system security, and any gallery backup service you enable remain under your control.</string>
    <string name="privacy_children_title">Children</string>
    <string name="privacy_children_body">Picmorrow is not designed to collect personal information from children and does not knowingly collect information from any user.</string>
    <string name="privacy_changes_title">Changes to this policy</string>
    <string name="privacy_changes_body">This policy will be updated when Picmorrow\'s features or data practices change. The effective date above identifies the latest revision.</string>
    <string name="privacy_view_online">View policy online</string>
    <string name="privacy_contact">Privacy questions and support</string>
